digraph G {rankdir=LR; graph [bgcolor="white",nodesep=.4,ranksep=.65]; node [shape=record,style="rounded,filled",fillcolor="#E9F1F7",color="#375A75",fontname="DejaVu Sans",fontsize=10]; edge [color="#607D8B",fontsize=9];
Track [label="{Track|title, artist, genre, lyrics|frequency}"]; LibraryFacade [label="{LibraryFacade|all(); search(); add()}"]; TrackFactory [label="{TrackFactory (abstract)|create()}"]; PopTrackFactory; JazzTrackFactory; ElectronicTrackFactory; TrackObserver [label="{TrackObserver|onTrackChanged()}"]; TrackPublisher [label="{TrackPublisher|subscribe(); publish()}"]; AudioStream [label="{AudioStream|render()}"]; AudioDecorator; EchoDecorator; LowPassDecorator; BaseAudioStream; SortStrategy [label="{SortStrategy|sort()}"]; SortByTitle; SortByArtist; SortByGenre; Command [label="{Command|execute()}"]; PlayCommand; PauseCommand; NextCommand; PreviousCommand; MusicPlayer; MusicApp;
LibraryFacade -> Track [label="stores"]; LibraryFacade -> TrackFactory [label="uses"]; PopTrackFactory -> TrackFactory [arrowhead=empty];JazzTrackFactory -> TrackFactory [arrowhead=empty];ElectronicTrackFactory -> TrackFactory [arrowhead=empty]; TrackPublisher -> TrackObserver [label="notifies"];MusicApp -> TrackObserver [label="implements"]; MusicApp -> LibraryFacade;MusicApp -> MusicPlayer;MusicPlayer -> TrackPublisher;MusicPlayer -> AudioStream; AudioDecorator -> AudioStream [arrowhead=empty];BaseAudioStream -> AudioStream [arrowhead=empty];EchoDecorator -> AudioDecorator [arrowhead=empty];LowPassDecorator -> AudioDecorator [arrowhead=empty]; SortByTitle -> SortStrategy [arrowhead=empty];SortByArtist -> SortStrategy [arrowhead=empty];SortByGenre -> SortStrategy [arrowhead=empty];MusicApp -> SortStrategy; PlayCommand -> Command [arrowhead=empty];PauseCommand -> Command [arrowhead=empty];NextCommand -> Command [arrowhead=empty];PreviousCommand -> Command [arrowhead=empty];PlayCommand -> MusicPlayer;NextCommand -> MusicPlayer;
